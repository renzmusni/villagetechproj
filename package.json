{
  "name": "hoa-community-platform",
  "version": "1.0.0",
  "description": "Multi-tenant HOA Community Management Platform",
  "private": true,
  "workspaces": [
    "src/*",
    "libs/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:platform": "npm run dev --workspace=src/platform",
    "dev:admin": "npm run dev --workspace=src/admin",
    "dev:residence": "npm run dev --workspace=src/residence",
    "dev:sentinel": "npm run dev --workspace=src/sentinel"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:watch": "npm run test:watch --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:platform": "npm run dev --workspace=src/platform",
    "dev:admin": "npm run dev --workspace=src/admin",
    "dev:residence": "npm run dev --workspace=src/residence",
    "dev:sentinel": "npm run dev --workspace=src/sentinel",
    "start:all": "concurrently \"npm run dev:platform\" \"npm run dev:admin\" \"npm run dev:residence\" \"npm run dev:sentinel\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "playwright": "^1.40.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}