# Database Configuration
POSTGRES_PASSWORD=secure_password
DATABASE_URL=postgresql://hoa_admin:secure_password@localhost:5432/hoa_platform

# Redis Configuration
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@localhost:6379

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Application Ports
PLATFORM_PORT=3000
ADMIN_PORT=3001
RESIDENCE_PORT=3002
SENTINEL_PORT=3003

# Application URLs
PLATFORM_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
RESIDENCE_URL=http://localhost:3002
SENTINEL_URL=http://localhost:3003

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_key
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Development Configuration
NODE_ENV=development
DEBUG=false